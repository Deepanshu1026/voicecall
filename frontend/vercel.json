{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    { "src": "/(.*)", "continue": true, "headers": {
      "X-Content-Type-Options": "nosniff",
      "X-Frame-Options": "SAMEORIGIN",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "Permissions-Policy": "camera=(self), microphone=(self), geolocation=()",
      "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
      "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-src 'self' https:; media-src 'self' blob: https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    } },
    { "src": "/\\.env", "status": 404 },
    { "src": "/\\.env\\..*", "status": 404 },
    { "src": "/\\.git", "status": 404 },
    { "src": "/\\.git/.*", "status": 404 },
    { "src": "/\\.svn/.*", "status": 404 },
    { "src": "/\\.hg/.*", "status": 404 },
    { "src": "/\\.htaccess", "status": 404 },
    { "src": "/\\.DS_Store", "status": 404 },
    { "src": "/Thumbs\\.db", "status": 404 },
    { "src": "/.*\\.sql", "status": 404 },
    { "src": "/.*\\.(bak|backup|old|orig|swp|save)", "status": 404 },
    { "src": "/wp-config.*", "status": 404 },
    { "src": "/config\\.php", "status": 404 },
    { "src": "/configuration\\.php", "status": 404 },
    { "src": "/phpinfo.*", "status": 404 },
    { "src": "/admin\\.php", "status": 404 },
    { "src": "/adminer\\..*", "status": 404 },
    { "src": "/server-status", "status": 404 },
    { "src": "/composer\\.(json|lock)", "status": 404 },
    { "src": "/\\.aws/.*", "status": 404 },
    { "src": "/\\.ssh/.*", "status": 404 },
    { "src": "/WEB-INF/.*", "status": 404 },
    { "src": "/home", "status": 308, "headers": { "Location": "/" } },
    { "src": "/index\\.php", "status": 301, "headers": { "Location": "/" } },
    { "src": "/coming_soon\\.php", "status": 301, "headers": { "Location": "/" } },
    { "src": "/service\\.php", "status": 301, "headers": { "Location": "/services" } },
    { "src": "/workvisa\\.php", "status": 301, "headers": { "Location": "/services" } },
    { "src": "/about\\.php", "status": 301, "headers": { "Location": "/about" } },
    { "src": "/kaveesh-kapoor\\.php", "status": 301, "headers": { "Location": "/about" } },
    { "src": "/blogs\\.php", "status": 301, "headers": { "Location": "/blogs" } },
    { "src": "/blog_pages/.*", "status": 301, "headers": { "Location": "/blogs" } },
    { "src": "/consultant\\.php", "status": 301, "headers": { "Location": "/consultants" } },
    { "src": "/contact\\.php", "status": 301, "headers": { "Location": "/contact" } },
    { "src": "/appointment\\.php", "status": 301, "headers": { "Location": "/book-appointment" } },
    { "src": "/touristvisa1\\.php", "status": 301, "headers": { "Location": "/tourist-visa" } },
    { "src": "/transitvsa\\.php", "status": 301, "headers": { "Location": "/transit-visa" } },
    { "src": "/newlogin\\.php", "status": 301, "headers": { "Location": "/login" } },
    { "src": "/logout\\.php", "status": 301, "headers": { "Location": "/login" } },
    { "src": "/consultantlogin\\.php", "status": 301, "headers": { "Location": "/agent/login" } },
    { "src": "/signup\\.php", "status": 301, "headers": { "Location": "/register" } },
    { "src": "/userprofile\\.php", "status": 301, "headers": { "Location": "/profile" } },
    { "src": "/about", "dest": "https://avisaexperts-next.vercel.app/about" },
    { "src": "/services", "dest": "https://avisaexperts-next.vercel.app/services" },
    { "src": "/tourist-visa", "dest": "https://avisaexperts-next.vercel.app/tourist-visa" },
    { "src": "/work-visa", "status": 301, "headers": { "Location": "/services" } },
    { "src": "/transit-visa", "dest": "https://avisaexperts-next.vercel.app/transit-visa" },
    { "src": "/usa-visitor-visa", "status": 301, "headers": { "Location": "/usa-visa" } },
    { "src": "/canada-visitor-visa", "status": 301, "headers": { "Location": "/canada-visa" } },
    { "src": "/uk-visitor-visa", "status": 301, "headers": { "Location": "/uk-visa" } },
    { "src": "/usa-visa/usa-b1b2-visa", "dest": "https://avisaexperts-next.vercel.app/usa-visa/usa-b1b2-visa" },
    { "src": "/usa-b1b2-visa", "status": 301, "headers": { "Location": "/usa-visa/usa-b1b2-visa" } },
    { "src": "/usa-visa", "dest": "https://avisaexperts-next.vercel.app/usa-visa" },
    { "src": "/usa-visa/(.*)", "dest": "https://avisaexperts-next.vercel.app/usa-visa/$1" },
    { "src": "/canada-visa", "dest": "https://avisaexperts-next.vercel.app/canada-visa" },
    { "src": "/uk-visa", "dest": "https://avisaexperts-next.vercel.app/uk-visa" },
    { "src": "/uk-visa/(.*)", "dest": "https://avisaexperts-next.vercel.app/uk-visa/$1" },
    { "src": "/immigration-laws", "dest": "https://avisaexperts-next.vercel.app/immigration-laws" },
    { "src": "/immigration-lawyers", "dest": "https://avisaexperts-next.vercel.app/immigration-lawyers" },
    { "src": "/appointment", "dest": "https://avisaexperts-next.vercel.app/appointment" },
    { "src": "/contact", "dest": "https://avisaexperts-next.vercel.app/contact" },
    { "src": "/blogs", "dest": "https://avisaexperts-next.vercel.app/blogs" },
    { "src": "/blog/minimum-bank-balance-for-uk-visa-what-you-really-need-to-know-in-2026", "status": 301, "headers": { "Location": "/blog/uk-visa-bank-balance-requirements-2026-how-much-money-do-you-need" } },
    { "src": "/blog/minimum-bank-balance-for-uk-tourist-visa-from-india-a-clear-guide-by-avisaexperts", "status": 301, "headers": { "Location": "/blog/uk-visa-bank-balance-requirements-2026-how-much-money-do-you-need" } },
    { "src": "/blog/usa-visit-visa-from-india-b1b2-visa-guide-for-indian-travelers", "status": 301, "headers": { "Location": "/blog/usa-tourist-visa" } },
    { "src": "/blog/([^/]+)/([^/]+)", "dest": "https://avisaexperts-next.vercel.app/blog/$1/$2" },
    { "src": "/blog/([^/]+)", "dest": "https://avisaexperts-next.vercel.app/blog/$1" },
    { "src": "/_next/(.*)", "dest": "https://avisaexperts-next.vercel.app/_next/$1" },
    { "src": "^/$", "dest": "https://avisaexperts-next.vercel.app/" },
    { "src": "/sitemap.xml", "dest": "https://avisaexperts-next.vercel.app/sitemap.xml" },
    { "handle": "filesystem" },
    { "src": "/login", "dest": "/index.html" },
    { "src": "/register", "dest": "/index.html" },
    { "src": "/agent/login", "dest": "/index.html" },
    { "src": "/agent/dashboard", "dest": "/index.html" },
    { "src": "/agent/dashboard/.*", "dest": "/index.html" },
    { "src": "/consultants", "dest": "/index.html" },
    { "src": "/book-appointment", "dest": "/index.html" },
    { "src": "/appointment-payment", "dest": "/index.html" },
    { "src": "/user/.*", "dest": "/index.html" },
    { "src": "/chat", "dest": "/index.html" },
    { "src": "/settings", "dest": "/index.html" },
    { "src": "/profile", "dest": "/index.html" },
    { "src": "/(.*)", "status": 404 }
  ]
}
