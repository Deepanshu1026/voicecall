{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    { "src": "/home", "status": 308, "headers": { "Location": "/" } },
    { "src": "/about", "dest": "https://avisaexperts-next.vercel.app/about" },
    { "src": "/services", "dest": "https://avisaexperts-next.vercel.app/services" },
    { "src": "/tourist-visa", "dest": "https://avisaexperts-next.vercel.app/tourist-visa" },
    { "src": "/work-visa", "dest": "https://avisaexperts-next.vercel.app/work-visa" },
    { "src": "/transit-visa", "dest": "https://avisaexperts-next.vercel.app/transit-visa" },
    { "src": "/blogs", "dest": "https://avisaexperts-next.vercel.app/blogs" },
    { "src": "/blog/([^/]+)/([^/]+)", "dest": "https://avisaexperts-next.vercel.app/blog/$1/$2" },
    { "src": "/blog/([^/]+)", "dest": "https://avisaexperts-next.vercel.app/blog/$1" },
    { "src": "/_next/(.*)", "dest": "https://avisaexperts-next.vercel.app/_next/$1" },
    { "src": "^/$", "dest": "https://avisaexperts-next.vercel.app/" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
